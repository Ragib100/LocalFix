# Server
NODE_ENV=production
PORT=5000
CLIENT_URL=https://localfix.vercel.app,https://localfix.cse-app.me

# PostgreSQL connection string. URL-encode special characters in USER or
# PASSWORD. Use the pooled URL for application queries.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full

# Neon Object Storage credentials (run `neon deploy` and `neon env pull` to get these or go to the Neon storage dashboard and get the credentials from there)
AWS_ACCESS_KEY_ID=your-neon-storage-access-key
AWS_SECRET_ACCESS_KEY=your-neon-storage-secret-key
AWS_ENDPOINT_URL_S3=https://your-branch-storage-endpoint
AWS_REGION=ap-southeast-1

# Authentication and integrations
JWT_SECRET=replace-with-a-long-random-secret
MAPBOX_TOKEN=your-mapbox-token
RESEND_API_KEY=your-resend-api-key
Email_from=your-verified-sender@example.com
# Uploads
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads
